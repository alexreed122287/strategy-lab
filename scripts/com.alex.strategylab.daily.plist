<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Strategy Lab daily build - launchd template (same pattern as the autopilot
  and rsi2_x32_paper plists).

  Install:
    chmod +x ~/repos/strategy-lab-site/scripts/daily_build.sh
    cp ~/repos/strategy-lab-site/scripts/com.alex.strategylab.daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.alex.strategylab.daily.plist
  Manual run:
    bash ~/repos/strategy-lab-site/scripts/daily_build.sh
  Fires weekdays 15:30 CT (4:30 PM ET, after the close). Log:
    ~/repos/strategy-lab-site/.daily_build.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.alex.strategylab.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/repos/strategy-lab-site/scripts/daily_build.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <!--
    daily_build.sh redirects its own output into .daily_build.log, but only
    AFTER it starts. If launchd cannot start it at all - wrong path, not
    executable, bash missing - that failure lands nowhere and the job looks
    like it simply never fired. These two paths catch exactly that window.
    Check .daily_build.err first when a run appears to have been skipped.
  -->
  <key>StandardOutPath</key><string>/tmp/strategylab.daily.out</string>
  <key>StandardErrorPath</key><string>/tmp/strategylab.daily.err</string>
</dict>
</plist>
